 -- SY-specific file
import kotlin.Boolean;

CREATE TABLE merged(
    _id INTEGER NOT NULL PRIMARY KEY,
    info_manga INTEGER AS Boolean NOT NULL,
    get_chapter_updates INTEGER AS Boolean NOT NULL,
    chapter_sort_mode INTEGER NOT NULL,
    chapter_priority INTEGER NOT NULL,
    download_chapters INTEGER AS Boolean NOT NULL,
    merge_id INTEGER NOT NULL,
    merge_url TEXT NOT NULL,
    manga_id INTEGER,
    manga_url TEXT NOT NULL,
    manga_source INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE SET NULL,
    FOREIGN KEY(merge_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE INDEX merged_merge_id_index ON merged(merge_id);

selectByMergeId:
SELECT * FROM merged WHERE merge_id = ?;

deleteByMergeId:
DELETE FROM merged WHERE merge_id = ?;

selectMergedMangasById:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_artist, manga.remote_author, manga.remote_description, manga.remote_genre, manga.remote_title,
    manga.remote_status, manga.remote_cover, manga.state_chapter_last_update, manga.state_chapter_next_update, manga.state_initialized,
    manga.user_reader_flags, manga.user_chapter_flags, manga.state_cover_last_modified, manga.remote_update_strategy,
    manga.state_chapter_fetch_interval, manga.user_notes, manga.remote_memo, manga.user_favorite_at,
    manga.state_last_modified_at, manga.state_version, manga.state_is_syncing
FROM (
    SELECT manga_id FROM merged WHERE merge_id = ?
) AS M
JOIN manga
ON manga.id = M.manga_id;

selectMergedMangasForDownloadingById:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_artist, manga.remote_author, manga.remote_description, manga.remote_genre, manga.remote_title,
    manga.remote_status, manga.remote_cover, manga.state_chapter_last_update, manga.state_chapter_next_update, manga.state_initialized,
    manga.user_reader_flags, manga.user_chapter_flags, manga.state_cover_last_modified, manga.remote_update_strategy,
    manga.state_chapter_fetch_interval, manga.user_notes, manga.remote_memo, manga.user_favorite_at,
    manga.state_last_modified_at, manga.state_version, manga.state_is_syncing
FROM (
    SELECT manga_id FROM merged WHERE merge_id = ? AND download_chapters = 1
) AS M
JOIN manga
ON manga.id = M.manga_id;

selectAllMergedMangas:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_artist, manga.remote_author, manga.remote_description, manga.remote_genre, manga.remote_title,
    manga.remote_status, manga.remote_cover, manga.state_chapter_last_update, manga.state_chapter_next_update, manga.state_initialized,
    manga.user_reader_flags, manga.user_chapter_flags, manga.state_cover_last_modified, manga.remote_update_strategy,
    manga.state_chapter_fetch_interval, manga.user_notes, manga.remote_memo, manga.user_favorite_at,
    manga.state_last_modified_at, manga.state_version, manga.state_is_syncing
FROM (
    SELECT manga_id FROM merged
) AS M
JOIN manga
ON manga.id = M.manga_id;

selectAll:
SELECT * FROM merged;

insertReturningId:
INSERT INTO merged(
    info_manga,
    get_chapter_updates,
    chapter_sort_mode,
    chapter_priority,
    download_chapters,
    merge_id,
    merge_url,
    manga_id,
    manga_url,
    manga_source
)
VALUES (
    :infoManga,
    :getChapterUpdates,
    :chapterSortMode,
    :chapterPriority,
    :downloadChapters,
    :mergeId,
    :mergeUrl,
    :mangaId,
    :mangaUrl,
    :mangaSource
)
RETURNING _id;

insert:
INSERT INTO merged(
    info_manga,
    get_chapter_updates,
    chapter_sort_mode,
    chapter_priority,
    download_chapters,
    merge_id,
    merge_url,
    manga_id,
    manga_url,
    manga_source
)
VALUES (
    :infoManga,
    :getChapterUpdates,
    :chapterSortMode,
    :chapterPriority,
    :downloadChapters,
    :mergeId,
    :mergeUrl,
    :mangaId,
    :mangaUrl,
    :mangaSource
);

updateSettingsById:
UPDATE merged
SET
    get_chapter_updates = coalesce(:getChapterUpdates, get_chapter_updates),
    download_chapters = coalesce(:downloadChapters, download_chapters),
    info_manga = coalesce(:infoManga, info_manga),
    chapter_priority = coalesce(:chapterPriority, chapter_priority),
    chapter_sort_mode = coalesce(:chapterSortMode, chapter_sort_mode)
WHERE _id = :id;

deleteById:
DELETE FROM merged WHERE _id = ?;

deleteAll:
DELETE FROM merged;
