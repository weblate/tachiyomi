import kotlin.Boolean;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE chapter(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_name TEXT NOT NULL,
    remote_scanlator TEXT,
    remote_chapter_number REAL NOT NULL,
    remote_date_upload INTEGER NOT NULL,
    remote_order INTEGER NOT NULL,
    remote_memo BLOB AS JsonObject NOT NULL,
    user_read INTEGER AS Boolean NOT NULL,
    user_bookmark INTEGER AS Boolean NOT NULL,
    user_last_page_read INTEGER NOT NULL,
    state_date_fetch INTEGER NOT NULL,
    -- SY -->
    state_last_modified_at INTEGER NOT NULL DEFAULT 0,
    state_version INTEGER NOT NULL DEFAULT 0,
    state_is_syncing INTEGER NOT NULL DEFAULT 0,
    -- SY <--
    UNIQUE(manga_id, remote_url),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE INDEX chapter_state_date_fetch_index ON chapter(state_date_fetch);
CREATE INDEX chapter_unread_state_date_fetch_index ON chapter(state_date_fetch) WHERE user_read = 0;

-- SY -->
CREATE TRIGGER update_last_modified_at_chapter
AFTER UPDATE ON chapter
FOR EACH ROW
WHEN new.state_is_syncing = 0 AND old.state_is_syncing = 0
BEGIN
  UPDATE chapter
  SET state_last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_chapter_version AFTER UPDATE ON chapter
WHEN new.state_is_syncing = 0 AND (
    new.user_read != old.user_read OR
    new.user_bookmark != old.user_bookmark OR
    new.user_last_page_read != old.user_last_page_read
)
BEGIN
    UPDATE chapter SET state_version = state_version + 1
    WHERE id = new.id;
END;
-- SY <--

getChapterById:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator,
    user_read, user_bookmark, user_last_page_read, remote_chapter_number, remote_order,
    state_date_fetch, remote_date_upload,
    remote_memo,
    -- SY -->
    state_last_modified_at, state_version, state_is_syncing
    -- SY <--
FROM chapter
WHERE id = :id;

getChaptersByMangaId:
SELECT
    C.id, C.manga_id, C.remote_url, C.remote_name, C.remote_scanlator,
    C.user_read, C.user_bookmark, C.user_last_page_read, C.remote_chapter_number, C.remote_order,
    C.state_date_fetch, C.remote_date_upload,
    C.remote_memo,
    -- SY -->
    C.state_last_modified_at, C.state_version, C.state_is_syncing
    -- SY <--
FROM chapter C
LEFT JOIN excluded_scanlator ES
ON C.manga_id = ES.manga_id
AND C.remote_scanlator = ES.scanlator
WHERE C.manga_id = :mangaId
AND (
    :applyScanlatorFilter = 0
    OR ES.scanlator IS NULL
);

getScanlatorsByMangaId:
SELECT remote_scanlator
FROM chapter
WHERE manga_id = :mangaId;

getBookmarkedChaptersByMangaId:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator,
    user_read, user_bookmark, user_last_page_read, remote_chapter_number, remote_order,
    state_date_fetch, remote_date_upload,
    remote_memo,
    -- SY -->
    state_last_modified_at, state_version, state_is_syncing
    -- SY <--
FROM chapter
WHERE user_bookmark
AND manga_id = :mangaId;

getChapterByUrl:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator,
    user_read, user_bookmark, user_last_page_read, remote_chapter_number, remote_order,
    state_date_fetch, remote_date_upload,
    remote_memo,
    -- SY -->
    state_last_modified_at, state_version, state_is_syncing
    -- SY <--
FROM chapter
WHERE remote_url = :chapterUrl;

getChapterByUrlAndMangaId:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator,
    user_read, user_bookmark, user_last_page_read, remote_chapter_number, remote_order,
    state_date_fetch, remote_date_upload,
    remote_memo,
    -- SY -->
    state_last_modified_at, state_version, state_is_syncing
    -- SY <--
FROM chapter
WHERE remote_url = :chapterUrl
AND manga_id = :mangaId
LIMIT 1;

removeChaptersWithIds:
DELETE FROM chapter
WHERE id IN :chapterIds;

insert:
INSERT INTO chapter(manga_id, remote_url, remote_name, remote_scanlator, user_read, user_bookmark, user_last_page_read, remote_chapter_number, remote_order, state_date_fetch, remote_date_upload, remote_memo, state_last_modified_at, state_version)
VALUES (:mangaId, :url, :name, :scanlator, :read, :bookmark, :lastPageRead, :chapterNumber, :sourceOrder, :dateFetch, :dateUpload, :memo, :lastModifiedAt, :version);

insertReturningId:
INSERT INTO chapter(
    manga_id, remote_url, remote_name, remote_scanlator, user_read, user_bookmark,
    user_last_page_read, remote_chapter_number, remote_order, state_date_fetch,
    remote_date_upload, remote_memo, state_last_modified_at, state_version
)
VALUES (
    :mangaId, :url, :name, :scanlator, :read, :bookmark,
    :lastPageRead, :chapterNumber, :sourceOrder, :dateFetch,
    :dateUpload, :memo, :lastModifiedAt, :version
)
RETURNING id;

update:
UPDATE chapter
SET user_read = coalesce(:read, user_read),
    user_bookmark = coalesce(:bookmark, user_bookmark),
    user_last_page_read = coalesce(:lastPageRead, user_last_page_read),
    state_date_fetch = coalesce(:dateFetch, state_date_fetch)
WHERE id = :chapterId;

updateFromBackup:
UPDATE chapter
SET user_read = coalesce(:read, user_read),
    user_bookmark = coalesce(:bookmark, user_bookmark),
    user_last_page_read = coalesce(:lastPageRead, user_last_page_read),
    remote_memo = coalesce(:memo, remote_memo),
    state_last_modified_at = coalesce(:lastModifiedAt, state_last_modified_at),
    state_version = coalesce(:version, state_version),
    state_is_syncing = coalesce(:isSyncing, state_is_syncing)
WHERE id = :chapterId;

updateRemote:
UPDATE chapter
SET remote_name = :name,
    remote_scanlator = coalesce(:scanlator, remote_scanlator),
    remote_chapter_number = :chapterNumber,
    remote_order = :sourceOrder,
    remote_date_upload = coalesce(:dateUpload, remote_date_upload),
    remote_memo = :memo
WHERE id = :chapterId;

-- SY -->
getChapterSummaryByMangaId:
SELECT
    count(*) AS total,
    coalesce(max(remote_chapter_number), 0) AS latestChapterNumber
FROM chapter
WHERE manga_id = :mangaId;

getMergedChaptersByMangaId:
SELECT
    C.id, C.manga_id, C.remote_url, C.remote_name, C.remote_scanlator,
    C.user_read, C.user_bookmark, C.user_last_page_read, C.remote_chapter_number, C.remote_order,
    C.state_date_fetch, C.remote_date_upload,
    C.remote_memo,
    C.state_last_modified_at, C.state_version, C.state_is_syncing
FROM chapter C
LEFT JOIN excluded_scanlator ES
ON C.manga_id = ES.manga_id
AND C.remote_scanlator = ES.scanlator
WHERE C.manga_id IN (
    SELECT manga_id FROM merged WHERE merge_id = :mangaId
)
AND (
    :applyScanlatorFilter = 0
    OR ES.scanlator IS NULL
);

getScanlatorsByMergeId:
SELECT remote_scanlator
FROM chapter
WHERE manga_id IN (
    SELECT manga_id FROM merged WHERE merge_id = :mangaId
);

resetIsSyncing:
UPDATE chapter
SET state_is_syncing = 0
WHERE state_is_syncing = 1;
-- SY <--
